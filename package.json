{
  "name": "kiadstarstool-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo for the KiadStars Tool project, containing frontend and backend services.",
  "author": "",
  "license": "ISC",
  "workspaces": [
    "frontend",
    "backend_vercel"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "cd backend_vercel && npx vercel dev --yes",
    "build": "npm run build --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "cloudinary": "^2.9.0",
    "firebase": "^12.10.0"
  }
}
